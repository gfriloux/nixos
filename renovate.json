{
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.*\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\";\\s*# renovate"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
